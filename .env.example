# Copy to .env on the server. Used by docker-compose.yml.
PUBLIC_URL=https://example.com
# nginx.conf (HTTP) first, then nginx-https.conf after getting a certificate.
NGINX_CONF=nginx.conf

MAX_UPLOAD_SIZE_MB=20
MAX_IMAGE_PIXELS=25000000
MAX_IMAGE_DIMENSION=8000
FILE_RETENTION_HOURS=24
MAX_CONCURRENT_JOBS=2
RATE_LIMIT_PER_MINUTE=10

# Server already running other sites on 80/443? Use these instead (see DEPLOY.md, "Shared server"):
# NGINX_CONF=nginx-behind-proxy.conf
# HTTP_PORT=127.0.0.1:8080
# HTTPS_PORT=127.0.0.1:8443
